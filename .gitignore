# TradeSignal AI — local-only data files (auto-regenerated by the server).
# Keeping these out of git so per-machine learning survives `git pull` and
# never produces merge conflicts. The server rebuilds them on first startup
# (and weekly thereafter) via auto_refresh.py.
artifacts/api-server/trading/predictions.db
artifacts/api-server/trading/predictions.db-journal
artifacts/api-server/trading/predictions.db-wal
artifacts/api-server/trading/predictions.db-shm
artifacts/api-server/trading/track_record.json
artifacts/api-server/trading/regime_stats.json
artifacts/api-server/trading/discovered_strategies.json
# Local-only DB snapshots (auto-rotated, last 14 kept). Survives `git pull`
# and accidental deletes of predictions.db — see learning_backup.py.
artifacts/api-server/trading/backups/
